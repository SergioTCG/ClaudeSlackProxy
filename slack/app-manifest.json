{
  "display_information": {
    "name": "Slack Agent Bridge",
    "description": "Control and hand off local Claude Code, Codex, and Pi sessions from Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Clavdivs",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/cc-model", "description": "Show or set this Claude Code session's model", "usage_hint": "[model id or alias]", "should_escape": false },
      { "command": "/cc-effort", "description": "Show or set this Claude Code session's reasoning effort", "usage_hint": "[low | medium | high | max]", "should_escape": false },
      { "command": "/cc-new", "description": "Start a Claude Code session", "usage_hint": "[folder] [Claude flags]", "should_escape": false },
      { "command": "/cc-status", "description": "Claude session info here, or list Claude sessions", "should_escape": false },
      { "command": "/cc-usage", "description": "Token & cost usage — project here, aggregate in control channel", "usage_hint": "[days [n] | models | limits]", "should_escape": false },
      { "command": "/cc-health", "description": "Bridge daemon health", "should_escape": false },
      { "command": "/cc-cleanup", "description": "Archive dormant session channels", "should_escape": false },
      { "command": "/cc-claim", "description": "Claim this bridge as its owner (first-run setup)", "should_escape": false },
      { "command": "/cc-account", "description": "Which Claude subscription pays for this session", "usage_hint": "[name | default]", "should_escape": false },
      { "command": "/cc-flags", "description": "Show or change Claude Code launch flags", "usage_hint": "[--dsp] [--chrome]", "should_escape": false },
      { "command": "/cc-update", "description": "Update Claude Code and restart/resume this session", "should_escape": false },
      { "command": "/cc-stop", "description": "Interrupt this Claude Code session's running turn", "should_escape": false },
      { "command": "/cc-switch", "description": "Hand this channel from Claude Code to Codex or Pi", "usage_hint": "[codex | pi] [new]", "should_escape": false },
      { "command": "/cc-kill", "description": "End a Claude Code session (channel stays, resumable)", "usage_hint": "[here | session id]", "should_escape": false },
      { "command": "/cc-help", "description": "List Claude Code and bridge-wide commands", "should_escape": false },

      { "command": "/codex-model", "description": "Show or set this Codex session's model", "usage_hint": "[model id]", "should_escape": false },
      { "command": "/codex-effort", "description": "Show or set this Codex session's reasoning effort", "usage_hint": "[low | medium | high | xhigh | max | ultra]", "should_escape": false },
      { "command": "/codex-new", "description": "Start a Codex session", "usage_hint": "[folder] [Codex flags]", "should_escape": false },
      { "command": "/codex-status", "description": "Codex session info here, or list Codex sessions", "should_escape": false },
      { "command": "/codex-usage", "description": "Codex token & cost usage — session here, aggregate in control", "usage_hint": "[days [n] | models]", "should_escape": false },
      { "command": "/codex-flags", "description": "Show or change Codex launch flags", "usage_hint": "[--search] [--model=value]", "should_escape": false },
      { "command": "/codex-update", "description": "Update Codex and restart/resume this session", "should_escape": false },
      { "command": "/codex-stop", "description": "Interrupt this Codex session's running turn", "should_escape": false },
      { "command": "/codex-switch", "description": "Hand this channel from Codex to Claude Code or Pi", "usage_hint": "[claude | pi] [new]", "should_escape": false },
      { "command": "/codex-kill", "description": "End a Codex session (channel stays, resumable)", "usage_hint": "[here | session id]", "should_escape": false },
      { "command": "/codex-help", "description": "List Codex commands", "should_escape": false },

      { "command": "/pi-model", "description": "Show or set this Pi session's provider/model", "usage_hint": "[provider/model]", "should_escape": false },
      { "command": "/pi-effort", "description": "Show or set this Pi session's thinking level", "usage_hint": "[off | minimal | low | medium | high | xhigh | max]", "should_escape": false },
      { "command": "/pi-new", "description": "Start a Pi session", "usage_hint": "[folder] [Pi flags]", "should_escape": false },
      { "command": "/pi-status", "description": "Pi session info here, or list Pi sessions", "should_escape": false },
      { "command": "/pi-usage", "description": "Pi token and context usage", "usage_hint": "[days [n] | models]", "should_escape": false },
      { "command": "/pi-run", "description": "Control adaptive routing or force a managed Pi run", "usage_hint": "[plan] <goal> | mode [auto|always|native] | direct <prompt> | status|approve|pause|continue|cancel", "should_escape": false },
      { "command": "/pi-flags", "description": "Show or change Pi launch and trust flags", "usage_hint": "[--safe] [--approve] [--model=value]", "should_escape": false },
      { "command": "/pi-update", "description": "Update Pi and restart/resume this session", "should_escape": false },
      { "command": "/pi-stop", "description": "Interrupt this Pi session's running turn", "should_escape": false },
      { "command": "/pi-switch", "description": "Hand this channel from Pi to Claude Code or Codex", "usage_hint": "[claude | codex] [new]", "should_escape": false },
      { "command": "/pi-kill", "description": "End a Pi session (channel stays, resumable)", "usage_hint": "[here | session id]", "should_escape": false },
      { "command": "/pi-help", "description": "List Pi commands", "should_escape": false }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:manage",
        "channels:read",
        "channels:history",
        "groups:write",
        "groups:read",
        "groups:history",
        "files:write",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
